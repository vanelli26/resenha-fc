rules_version = '2';

// ===============================================================
// Storage — ResenhaFC (DIRETRIZES 2.8, 4)
//
// times/{timeId}/recados/{recadoId}/{N}.{webp|jpeg}   N = 0..3 (até 4 fotos por postagem)
//   Envio: membro do time, só imagem webp/jpeg até 5 MB, metadado autorUid = quem envia; não sobrescreve.
//   Leitura (SDK): membro do time. As URLs de download (com token) são as gravadas no post.
//   Exclusão: quem enviou (autorUid) ou a diretoria.
// times/{timeId}/escudo/{data-hora}.{webp|png|jpeg}
//   Envio e exclusão: diretoria do time. Imagem até 1 MB. Leitura: qualquer logado
//   (aparece em "Meus times" e no seletor de times).
// Consulta o Firestore (firestore.get/exists): exige o papel de IAM concedido pela CLI no deploy.
// Todo o resto: negado.
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {

    function logado() {
      return request.auth != null;
    }

    function acesso(timeId) {
      return /databases/(default)/documents/times/$(timeId)/acessos/$(request.auth.uid);
    }

    function membro(timeId) {
      return logado() && firestore.exists(acesso(timeId));
    }

    function diretoria(timeId) {
      return membro(timeId) && 'diretoria' in firestore.get(acesso(timeId)).data.papeis;
    }

    match /times/{timeId}/escudo/{arquivo} {
      allow read: if logado();

      allow create: if diretoria(timeId)
        && arquivo.matches('^[0-9]{13}[.](webp|png|jpeg)$')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/(webp|png|jpeg)');

      allow update: if false;

      allow delete: if diretoria(timeId);
    }

    match /times/{timeId}/recados/{recadoId}/{arquivo} {
      allow read: if membro(timeId);

      allow create: if membro(timeId)
        && arquivo.matches('^[0-3][.](webp|jpeg)$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg)')
        && request.resource.metadata.autorUid == request.auth.uid;

      allow update: if false;

      allow delete: if logado()
        && (resource.metadata.autorUid == request.auth.uid || diretoria(timeId));
    }
  }
}
