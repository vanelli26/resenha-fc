{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "inicial",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/main-*.js", "/styles-*.css"]
      }
    },
    {
      "name": "telas",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/*.js", "!/sw-principal.js"]
      }
    },
    {
      "name": "marca",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/marca/**", "/escudos/**"]
      }
    }
  ]
}
