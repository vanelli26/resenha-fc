rules_version = '2';

// ===============================================================
// ResenhaFC — Security Rules (Fases 0 a 3)
// Fonte: DIRETRIZES.md, seções 3 e 4. Negar tudo por padrão; liberar por coleção.
// Protótipo: revisar e endurecer a cada fase antes de ampliar o público.
// ===============================================================
//
// Modelo de dados assumido
//
// usuarios/{uid}
//   nome: string (0..100) · email: string (<= 254, = token.email) · fotoUrl: https string (<= 2048) | null
//   criadoEm: timestamp (= request.time na criação, imutável)
//   adminGeral: bool (opcional; só console/Admin SDK — o client nunca escreve)
//
// times/{timeId}                       timeId = slug
//   nome: string (1..60) · slug: string (= timeId, imutável) · cor: nome de paleta (lista fixa)
//   escudo: URL do Storage do projeto (times/{timeId}/escudo/…) | data URL base64 antigo (<= 120000) | null
//   criadoEm: timestamp (imutável)
//   (campo antigo `tema` só pode ser removido)
//   financeiro: { planos: list 0..10 de {id [a-z0-9]{3,20} (≠ isento), nome 1..40, periodicidade: 'mensal'|'semestral'|'avulso', valorCentavos > 0},
//                 vencimentos: {diaMensal, diaSemestral 1..31, mesS1 1..6, mesS2 7..12},
//                 despesasRecorrentes: list 0..10 de {id, descricao, categoria, valorCentavos, diaVencimento} }
//   (nasce sem planos; depois só tesouraria/adminGeral altera, e só esse campo. Times antigos ainda podem ter o
//    formato anterior {mensal, semestral, avulso, despesasRecorrentes}: é lido, e a próxima gravação converte.)
//   esportes?: list 1..3 de 'campo' | 'society' | 'futsal' (ausente = só society; adminGeral ou diretoria altera)
//
// times/{timeId}/acessos/{uid}
//   uid (= path) · timeId (= path) · timeNome (= times.nome) · nome: string (1..100)
//   papeis: list 1..3 de 'jogador' | 'diretoria' | 'tesouraria' · atletaId: string (atleta existente) | null
//   concedidoPor: string (= request.auth.uid) · atualizadoEm: timestamp (= request.time)
//
// times/{timeId}/atletas/{atletaId}
//   nome (1..100) · apelido (0..40) · telefone? (1..20) · fotoUrl? (https) · uid: string | null
//   modalidade: id de um plano do time | 'isento' (conferida só quando muda)
//   posicoes: { campo?: list 0..10, society?: list 0..6, futsal?: list 0..5 } das posições fixas de cada esporte
//             (formato antigo, ainda aceito: list 0..6 das posições de society)
//   numeroCamisa?: int 0..999 · status: 'ativo' | 'afastado' | 'inativo'
//   vinculo?: 'atleta' | 'socio' | 'colaborador' (ausente = atleta; só a diretoria altera; sócio/colaborador exige uid)
//   criadoEm (imutável) · atualizadoEm (= request.time)
//
// times/{timeId}/convites/{codigo}     codigo: 10..32 [A-Za-z0-9]
//   timeNome (= times.nome) · ativo: bool · expiraEm: timestamp (até 90 dias) · criadoPor · criadoEm
//
// times/{timeId}/solicitacoes/{uid}
//   nome (0..100) · email (= token.email) · status: 'pendente' | 'aprovada' | 'recusada'
//   convite: código de um convite ativo e não expirado · criadoEm (= request.time)
//
// times/{timeId}/cobrancas/{atletaId}_{referencia}
//   atletaId (1..40) · atletaNome (1..100) · tipo: 'mensal' | 'semestral' | 'avulso'
//   referencia: AAAA-MM | AAAA-S1/S2 | eventoId (conforme o tipo) · valorCentavos: int > 0 · vencimento: timestamp
//   planoNome? (1..40, nome do plano na geração) · status: 'pendente' | 'pago' | 'cancelado'
//   pagoEm?: timestamp · baixadoPor?: uid · observacao? (0..200)
//   Imutáveis após criar: tudo menos status/pagoEm/baixadoPor/observacao. Nunca excluída.
//
// times/{timeId}/lancamentos/{id}      id: cob_{cobrancaId} (baixa) | rec_{recorrenteId}_{AAAA-MM} | automático (manual)
//   tipo: 'receita' | 'despesa' · categoria (1..40) · descricao (1..120) · valorCentavos: int > 0 · data: timestamp
//   cobrancaId? · recorrenteId? · criadoPor (= request.auth.uid) · criadoEm (= request.time, imutável)
//
// times/{timeId}/eventos/{eventoId}   (não é excluído: cancelado fica na agenda)
//   tipo: 'jogo'|'treino'|'amistoso'|'campeonato'|'confraternizacao'|'outro' · titulo (1..80) · data: timestamp
//   local (0..120) · esporte: 'campo'|'society'|'futsal' · adversario? (1..60) · status: 'agendado'|'cancelado'|'realizado'
//   placarPro?/placarContra? (int 0..99, juntos, só em realizado) · criadoPor (= request.auth.uid) · criadoEm (= request.time); imutáveis
//   Transições: agendado ↔ cancelado; agendado → realizado (encerrar); realizado não volta.
//
// times/{timeId}/eventos/{eventoId}/presencas/{atletaId}
//   resposta?: 'vou'|'nao_vou'|'talvez' (da própria pessoa) · compareceu?: bool (só diretoria, no encerramento)
//   atualizadoEm (= request.time)
//
// times/{timeId}/eventos/{eventoId}/gols/{NN}     NN = ordem "01".."99"
//   autorId: atletaId | null (gol contra) · assistenciaId? (≠ autor; nunca em gol contra) · atualizadoEm (= request.time)
//   Só a diretoria, e só com o evento realizado. A soma ≤ placar é conferida na UI.
//
// times/{timeId}/patrocinadores/{id}   (até 20; limite na UI)
//   nome (1..60) · logo: data URL webp/png/jpeg (<= 80000) | null · link? (https) · ordem: int 0..99 · criadoEm (imutável)
//
// times/{timeId}/recados/{id}   (postagem do mural; qualquer membro publica)
//   texto (0..2000) · fotos?: list 1..4 de {url https, caminho = times/{timeId}/recados/{id}/{0-3}.webp|jpeg, largura, altura}
//   titulo? (1..100, posts antigos) · precisa de texto, fotos ou título · fixado: bool (só diretoria liga)
//   autorUid (= request.auth.uid) · autorNome (1..100) · autorFotoUrl? (https) · criadoEm (= request.time)
//   qtdCurtidas?: int >= 0 (nunca na criação; ±1 só junto com a curtida da própria pessoa)
//   Autor edita só `texto`; diretoria só `fixado`; exclui o autor ou a diretoria. Fotos no Storage (storage.rules).
//
// times/{timeId}/recados/{id}/curtidas/{uid}      criadoEm (= request.time) — existir = curtiu
// times/{timeId}/recados/{id}/comentarios/{id}    texto (1..500) · autorUid (= request.auth.uid) · autorNome (1..100)
//   autorFotoUrl? (https) · criadoEm (= request.time). Sem edição; exclui o autor, o autor do post ou a diretoria.
//   Curtidas e comentários de um post que está sendo excluído (no mesmo lote) podem ser apagados.
//
// times/{timeId}/ajustesEstatistica/{escopo}_{atletaId}   (correção manual da artilharia)
//   atletaId (atleta existente) · escopo: ano 'AAAA' · gols, assistencias: int −999..999 (diferença sobre o automático)
//   atualizadoPor (= request.auth.uid) · atualizadoEm (= request.time). Só a diretoria; sem exclusão (zero = automático).
//
// Demais coleções (campeonatos...) entram nas próximas fases e ficam negadas.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdminGeral() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('adminGeral', false) == true;
    }

    function acessoPath(timeId) {
      return /databases/$(database)/documents/times/$(timeId)/acessos/$(request.auth.uid);
    }

    function temAcesso(timeId) {
      return isAuthenticated() && exists(acessoPath(timeId));
    }

    function temPapel(timeId, papel) {
      return temAcesso(timeId) && papel in get(acessoPath(timeId)).data.papeis;
    }

    function ehDiretoria(timeId) {
      return temPapel(timeId, 'diretoria');
    }

    function ehTesouraria(timeId) {
      return temPapel(timeId, 'tesouraria');
    }

    function podeGerir(timeId) {
      return ehDiretoria(timeId) || isAdminGeral();
    }

    // Opera o financeiro (configuração, cobranças, caixa): tesouraria ou adminGeral.
    function podeFinanceiro(timeId) {
      return ehTesouraria(timeId) || isAdminGeral();
    }

    // Vê caixa e cobranças de todos: diretoria, tesouraria ou adminGeral. Jogador nunca vê o caixa.
    function podeVerFinanceiro(timeId) {
      return ehDiretoria(timeId) || ehTesouraria(timeId) || isAdminGeral();
    }

    // Jogador editando o próprio atleta: vínculo nos dois lados (acesso.atletaId e atleta.uid)
    // e só os campos pessoais, incluindo nome e foto do Google (modalidade, status, vínculo e uid continuam com a diretoria).
    function ehProprioAtleta(timeId, atletaId) {
      return temAcesso(timeId)
        && get(acessoPath(timeId)).data.atletaId == atletaId
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'apelido', 'telefone', 'posicoes', 'numeroCamisa', 'fotoUrl', 'atualizadoEm']);
    }

    function nomeDoTime(timeId) {
      return get(/databases/$(database)/documents/times/$(timeId)).data.nome;
    }

    function isValidUrl(url) {
      return url is string && url.size() <= 2048 && url.matches('^https://.*');
    }

    function textoOpcional(data, campo, min, max) {
      return !(campo in data) || (data[campo] is string && data[campo].size() >= min && data[campo].size() <= max);
    }

    function inalterados(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // ---------------------------------------------------------------
    // Validadores de domínio (usados em create e update)
    // ---------------------------------------------------------------
    function isValidUsuario(data) {
      return data.keys().hasAll(['nome', 'email', 'fotoUrl', 'criadoEm'])
        && data.keys().hasOnly(['nome', 'email', 'fotoUrl', 'criadoEm', 'adminGeral'])
        && data.nome is string && data.nome.size() <= 100
        && data.email is string && data.email.size() <= 254
        && data.email == request.auth.token.email
        && (data.fotoUrl == null || isValidUrl(data.fotoUrl))
        && data.criadoEm is timestamp
        && (!('adminGeral' in data) || data.adminGeral is bool);
    }

    function financeiroPadrao() {
      return {
        'planos': [],
        'vencimentos': { 'diaMensal': 10, 'diaSemestral': 10, 'mesS1': 1, 'mesS2': 7 },
        'despesasRecorrentes': []
      };
    }

    function ehCentavos(v) {
      return v is int && v >= 0 && v <= 100000000;
    }

    function ehDia(v) {
      return v is int && v >= 1 && v <= 31;
    }

    function isValidDespesaRecorrente(d) {
      return d is map
        && d.keys().hasAll(['id', 'descricao', 'categoria', 'valorCentavos', 'diaVencimento'])
        && d.keys().hasOnly(['id', 'descricao', 'categoria', 'valorCentavos', 'diaVencimento'])
        && d.id is string && d.id.matches('^[a-z0-9]{6,20}$')
        && d.descricao is string && d.descricao.size() >= 1 && d.descricao.size() <= 80
        && d.categoria is string && d.categoria.size() >= 1 && d.categoria.size() <= 40
        && ehCentavos(d.valorCentavos) && d.valorCentavos > 0
        && ehDia(d.diaVencimento);
    }

    // Rules não têm laço: cada posição da lista (máx. 10) é validada explicitamente.
    function despesasValidas(l) {
      return l is list && l.size() <= 10
        && (l.size() < 1 || isValidDespesaRecorrente(l[0]))
        && (l.size() < 2 || isValidDespesaRecorrente(l[1]))
        && (l.size() < 3 || isValidDespesaRecorrente(l[2]))
        && (l.size() < 4 || isValidDespesaRecorrente(l[3]))
        && (l.size() < 5 || isValidDespesaRecorrente(l[4]))
        && (l.size() < 6 || isValidDespesaRecorrente(l[5]))
        && (l.size() < 7 || isValidDespesaRecorrente(l[6]))
        && (l.size() < 8 || isValidDespesaRecorrente(l[7]))
        && (l.size() < 9 || isValidDespesaRecorrente(l[8]))
        && (l.size() < 10 || isValidDespesaRecorrente(l[9]));
    }

    function isValidPlano(p) {
      return p is map
        && p.keys().hasAll(['id', 'nome', 'periodicidade', 'valorCentavos'])
        && p.keys().hasOnly(['id', 'nome', 'periodicidade', 'valorCentavos'])
        && p.id is string && p.id.matches('^[a-z0-9]{3,20}$') && p.id != 'isento'
        && p.nome is string && p.nome.size() >= 1 && p.nome.size() <= 40
        && p.periodicidade in ['mensal', 'semestral', 'avulso']
        && ehCentavos(p.valorCentavos) && p.valorCentavos > 0;
    }

    // Sem laço: cada posição da lista (máx. 10) é validada explicitamente.
    function planosValidos(l) {
      return l is list && l.size() <= 10
        && (l.size() < 1 || isValidPlano(l[0]))
        && (l.size() < 2 || isValidPlano(l[1]))
        && (l.size() < 3 || isValidPlano(l[2]))
        && (l.size() < 4 || isValidPlano(l[3]))
        && (l.size() < 5 || isValidPlano(l[4]))
        && (l.size() < 6 || isValidPlano(l[5]))
        && (l.size() < 7 || isValidPlano(l[6]))
        && (l.size() < 8 || isValidPlano(l[7]))
        && (l.size() < 9 || isValidPlano(l[8]))
        && (l.size() < 10 || isValidPlano(l[9]));
    }

    function planoNaLista(l, id) {
      return (l.size() > 0 && l[0].id == id) || (l.size() > 1 && l[1].id == id)
        || (l.size() > 2 && l[2].id == id) || (l.size() > 3 && l[3].id == id)
        || (l.size() > 4 && l[4].id == id) || (l.size() > 5 && l[5].id == id)
        || (l.size() > 6 && l[6].id == id) || (l.size() > 7 && l[7].id == id)
        || (l.size() > 8 && l[8].id == id) || (l.size() > 9 && l[9].id == id);
    }

    // Toda gravação da configuração usa o formato de planos (converte times antigos).
    function isValidFinanceiro(f) {
      return f is map
        && f.keys().hasAll(['planos', 'vencimentos', 'despesasRecorrentes'])
        && f.keys().hasOnly(['planos', 'vencimentos', 'despesasRecorrentes'])
        && planosValidos(f.planos)
        && f.vencimentos is map
        && f.vencimentos.keys().hasAll(['diaMensal', 'diaSemestral', 'mesS1', 'mesS2'])
        && f.vencimentos.keys().hasOnly(['diaMensal', 'diaSemestral', 'mesS1', 'mesS2'])
        && ehDia(f.vencimentos.diaMensal) && ehDia(f.vencimentos.diaSemestral)
        && f.vencimentos.mesS1 is int && f.vencimentos.mesS1 >= 1 && f.vencimentos.mesS1 <= 6
        && f.vencimentos.mesS2 is int && f.vencimentos.mesS2 >= 7 && f.vencimentos.mesS2 <= 12
        && despesasValidas(f.despesasRecorrentes);
    }

    // Atleta só recebe plano existente no time (DIRETRIZES 2.4); isento sempre vale.
    // Time ainda no formato antigo: modalidade = nome da modalidade ativa.
    function modalidadeHabilitada(timeId, modalidade) {
      let f = get(/databases/$(database)/documents/times/$(timeId)).data.financeiro;
      return modalidade == 'isento'
        || ('planos' in f && planoNaLista(f.planos, modalidade))
        || (!('planos' in f) && modalidade in ['mensal', 'semestral', 'avulso'] && f[modalidade].ativo == true);
    }

    function isValidTime(data, timeId) {
      return data.keys().hasAll(['nome', 'slug', 'cor', 'escudo', 'criadoEm', 'financeiro'])
        && data.keys().hasOnly(['nome', 'slug', 'cor', 'escudo', 'criadoEm', 'financeiro', 'esportes'])
        && (!('esportes' in data) || (data.esportes is list && data.esportes.size() >= 1 && data.esportes.size() <= 3
          && data.esportes.hasOnly(['campo', 'society', 'futsal'])))
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 60
        && data.slug == timeId && timeId.matches('^[a-z0-9-]{2,40}$')
        && data.cor in ['preto', 'red', 'rose', 'pink', 'fuchsia', 'purple', 'violet', 'indigo', 'blue', 'sky',
          'cyan', 'teal', 'emerald', 'green', 'lime', 'yellow', 'amber', 'orange']
        && (data.escudo == null
          || (data.escudo is string && data.escudo.size() <= 120000
            && data.escudo.matches('^data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+$'))
          || (data.escudo is string && data.escudo.size() <= 2048
            && data.escudo.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/resenhafc-2f357[.]firebasestorage[.]app/o/times%2F'
              + timeId + '%2Fescudo%2F.*')))
        && data.criadoEm is timestamp
        && data.financeiro is map;
    }

    function isValidAcesso(data, timeId, uid) {
      return data.keys().hasAll(['uid', 'timeId', 'timeNome', 'nome', 'papeis', 'atletaId', 'concedidoPor', 'atualizadoEm'])
        && data.keys().hasOnly(['uid', 'timeId', 'timeNome', 'nome', 'papeis', 'atletaId', 'concedidoPor', 'atualizadoEm'])
        && data.uid == uid
        && data.timeId == timeId
        && data.timeNome is string && data.timeNome.size() <= 60
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100
        && data.papeis is list && data.papeis.size() >= 1 && data.papeis.size() <= 3
        && data.papeis.hasOnly(['jogador', 'diretoria', 'tesouraria'])
        && (data.atletaId == null
          || (data.atletaId is string && data.atletaId.size() <= 40
            && existsAfter(/databases/$(database)/documents/times/$(timeId)/atletas/$(data.atletaId))))
        && data.concedidoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    function posicoesSociety() {
      return ['goleiro', 'fixo', 'ala_direita', 'ala_esquerda', 'meia', 'pivo'];
    }

    function posicoesValidas(p) {
      return (p is list && p.size() <= 6 && p.hasOnly(posicoesSociety()))
        || (p is map
          && p.keys().hasOnly(['campo', 'society', 'futsal'])
          && (!('campo' in p) || (p.campo is list && p.campo.size() <= 10
            && p.campo.hasOnly(['goleiro', 'zagueiro', 'lateral_direito', 'lateral_esquerdo', 'volante', 'meia',
              'meia_atacante', 'ponta_direita', 'ponta_esquerda', 'centroavante'])))
          && (!('society' in p) || (p.society is list && p.society.size() <= 6 && p.society.hasOnly(posicoesSociety())))
          && (!('futsal' in p) || (p.futsal is list && p.futsal.size() <= 5
            && p.futsal.hasOnly(['goleiro', 'fixo', 'ala_direita', 'ala_esquerda', 'pivo']))));
    }

    // Sócio e colaborador entram só por convite (com conta): vínculo diferente de atleta exige uid.
    function vinculoComConta(data) {
      return data.get('vinculo', 'atleta') == 'atleta' || data.uid != null;
    }

    function isValidAtleta(data) {
      return data.keys().hasAll(['nome', 'apelido', 'uid', 'modalidade', 'posicoes', 'status', 'criadoEm', 'atualizadoEm'])
        && data.keys().hasOnly(['nome', 'apelido', 'telefone', 'fotoUrl', 'uid', 'modalidade', 'posicoes',
          'numeroCamisa', 'status', 'vinculo', 'criadoEm', 'atualizadoEm'])
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 100
        && data.apelido is string && data.apelido.size() <= 40
        && textoOpcional(data, 'telefone', 1, 20)
        && (!('fotoUrl' in data) || isValidUrl(data.fotoUrl))
        && (data.uid == null || (data.uid is string && data.uid.size() <= 128))
        && data.modalidade is string && data.modalidade.matches('^[a-z0-9]{3,20}$')
        && posicoesValidas(data.posicoes)
        && (!('numeroCamisa' in data) || (data.numeroCamisa is int && data.numeroCamisa >= 0 && data.numeroCamisa <= 999))
        && data.status in ['ativo', 'afastado', 'inativo']
        && (!('vinculo' in data) || data.vinculo in ['atleta', 'socio', 'colaborador'])
        && data.criadoEm is timestamp
        && data.atualizadoEm == request.time;
    }

    function isValidEvento(data) {
      return data.keys().hasAll(['tipo', 'titulo', 'data', 'local', 'esporte', 'status', 'criadoPor', 'criadoEm'])
        && data.keys().hasOnly(['tipo', 'titulo', 'data', 'local', 'esporte', 'adversario', 'placarPro', 'placarContra',
          'status', 'criadoPor', 'criadoEm'])
        && data.tipo in ['jogo', 'treino', 'amistoso', 'campeonato', 'confraternizacao', 'outro']
        && data.titulo is string && data.titulo.size() >= 1 && data.titulo.size() <= 80
        && data.data is timestamp
        && data.local is string && data.local.size() <= 120
        && data.esporte in ['campo', 'society', 'futsal']
        && textoOpcional(data, 'adversario', 1, 60)
        && data.status in ['agendado', 'cancelado', 'realizado']
        && (('placarPro' in data) == ('placarContra' in data))
        && (!('placarPro' in data) || (data.status == 'realizado'
          && data.placarPro is int && data.placarPro >= 0 && data.placarPro <= 99
          && data.placarContra is int && data.placarContra >= 0 && data.placarContra <= 99))
        && data.criadoPor is string && data.criadoPor.size() <= 128
        && data.criadoEm is timestamp;
    }

    // agendado ↔ cancelado; agendado → realizado; realizado fica realizado (corrigir encerramento).
    function transicaoEventoValida(antes, depois) {
      return antes == depois
        || (antes in ['agendado', 'cancelado'] && depois in ['agendado', 'cancelado'])
        || (antes == 'agendado' && depois == 'realizado');
    }

    function isValidPresenca(data) {
      return data.keys().hasAll(['atualizadoEm'])
        && data.keys().hasOnly(['resposta', 'compareceu', 'atualizadoEm'])
        && (!('resposta' in data) || data.resposta in ['vou', 'nao_vou', 'talvez'])
        && (!('compareceu' in data) || data.compareceu is bool)
        && data.atualizadoEm == request.time;
    }

    // Presença do próprio cadastro: vínculo nos dois lados, cadastro ativo e evento agendado.
    // Esportivos: só atletas; confraternização e "outro": qualquer cadastro (DIRETRIZES 2.7).
    function respondeProprio(timeId, eventoId, atletaId) {
      let atleta = get(/databases/$(database)/documents/times/$(timeId)/atletas/$(atletaId)).data;
      let evento = get(/databases/$(database)/documents/times/$(timeId)/eventos/$(eventoId)).data;
      return temAcesso(timeId)
        && get(acessoPath(timeId)).data.atletaId == atletaId
        && atleta.uid == request.auth.uid
        && atleta.status == 'ativo'
        && evento.status == 'agendado'
        && (evento.tipo in ['confraternizacao', 'outro'] || atleta.get('vinculo', 'atleta') == 'atleta');
    }

    function isValidPatrocinador(data) {
      return data.keys().hasAll(['nome', 'logo', 'ordem', 'criadoEm'])
        && data.keys().hasOnly(['nome', 'logo', 'link', 'ordem', 'criadoEm'])
        && data.nome is string && data.nome.size() >= 1 && data.nome.size() <= 60
        && (data.logo == null
          || (data.logo is string && data.logo.size() <= 80000
            && data.logo.matches('^data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/=]+$')))
        && (!('link' in data) || isValidUrl(data.link))
        && data.ordem is int && data.ordem >= 0 && data.ordem <= 99
        && data.criadoEm is timestamp;
    }

    function isValidFotoPost(f, timeId, recadoId) {
      return f is map
        && f.keys().hasAll(['url', 'caminho', 'largura', 'altura'])
        && f.keys().hasOnly(['url', 'caminho', 'largura', 'altura'])
        && isValidUrl(f.url)
        && f.caminho is string
        && f.caminho.matches('^times/' + timeId + '/recados/' + recadoId + '/[0-3][.](webp|jpeg)$')
        && f.largura is int && f.largura >= 1 && f.largura <= 10000
        && f.altura is int && f.altura >= 1 && f.altura <= 10000;
    }

    // Sem laço: cada posição (máx. 4) validada explicitamente.
    function fotosValidas(l, timeId, recadoId) {
      return l is list && l.size() >= 1 && l.size() <= 4
        && isValidFotoPost(l[0], timeId, recadoId)
        && (l.size() < 2 || isValidFotoPost(l[1], timeId, recadoId))
        && (l.size() < 3 || isValidFotoPost(l[2], timeId, recadoId))
        && (l.size() < 4 || isValidFotoPost(l[3], timeId, recadoId));
    }

    function isValidRecado(data, timeId, recadoId) {
      return data.keys().hasAll(['texto', 'fixado', 'autorUid', 'autorNome', 'criadoEm'])
        && data.keys().hasOnly(['titulo', 'texto', 'fotos', 'fixado', 'autorUid', 'autorNome', 'autorFotoUrl', 'criadoEm', 'qtdCurtidas'])
        && textoOpcional(data, 'titulo', 1, 100)
        && data.texto is string && data.texto.size() <= 2000
        && (!('fotos' in data) || fotosValidas(data.fotos, timeId, recadoId))
        && (data.texto.size() > 0 || 'fotos' in data || 'titulo' in data)
        && data.fixado is bool
        && data.autorUid is string && data.autorUid.size() <= 128
        && data.autorNome is string && data.autorNome.size() >= 1 && data.autorNome.size() <= 100
        && (!('autorFotoUrl' in data) || isValidUrl(data.autorFotoUrl))
        && (!('qtdCurtidas' in data) || (data.qtdCurtidas is int && data.qtdCurtidas >= 0))
        && data.criadoEm is timestamp;
    }

    function recadoPath(timeId, recadoId) {
      return /databases/$(database)/documents/times/$(timeId)/recados/$(recadoId);
    }

    function curtidaPath(timeId, recadoId, uid) {
      return /databases/$(database)/documents/times/$(timeId)/recados/$(recadoId)/curtidas/$(uid);
    }

    // Contador do post muda ±1 exatamente quando a curtida da própria pessoa nasce ou some no mesmo lote.
    function contadorDeCurtidaValido(timeId, recadoId) {
      let antes = resource.data.get('qtdCurtidas', 0);
      let depois = request.resource.data.qtdCurtidas;
      let curtida = curtidaPath(timeId, recadoId, request.auth.uid);
      return depois is int
        && ((depois == antes + 1 && !exists(curtida) && existsAfter(curtida))
          || (depois == antes - 1 && depois >= 0 && exists(curtida) && !existsAfter(curtida)));
    }

    function isValidComentario(data) {
      return data.keys().hasAll(['texto', 'autorUid', 'autorNome', 'criadoEm'])
        && data.keys().hasOnly(['texto', 'autorUid', 'autorNome', 'autorFotoUrl', 'criadoEm'])
        && data.texto is string && data.texto.size() >= 1 && data.texto.size() <= 500
        && data.autorUid is string && data.autorUid.size() <= 128
        && data.autorNome is string && data.autorNome.size() >= 1 && data.autorNome.size() <= 100
        && (!('autorFotoUrl' in data) || isValidUrl(data.autorFotoUrl))
        && data.criadoEm is timestamp;
    }

    // Filho (curtida/comentário) apagável por moderação: diretoria, autor do post ou post sendo excluído no lote.
    function podeLimparFilhoDoPost(timeId, recadoId) {
      return podeGerir(timeId)
        || !existsAfter(recadoPath(timeId, recadoId))
        || (temAcesso(timeId) && get(recadoPath(timeId, recadoId)).data.autorUid == request.auth.uid);
    }

    function isValidGol(data, golId) {
      return golId.matches('^[0-9]{2}$') && golId != '00'
        && data.keys().hasAll(['autorId', 'atualizadoEm'])
        && data.keys().hasOnly(['autorId', 'assistenciaId', 'atualizadoEm'])
        && (data.autorId == null || (data.autorId is string && data.autorId.size() >= 1 && data.autorId.size() <= 40))
        && (!('assistenciaId' in data) || (data.autorId != null
          && data.assistenciaId is string && data.assistenciaId.size() >= 1 && data.assistenciaId.size() <= 40
          && data.assistenciaId != data.autorId))
        && data.atualizadoEm == request.time;
    }

    function isValidAjusteEstatistica(data, timeId, ajusteId) {
      return data.keys().hasOnly(['atletaId', 'escopo', 'gols', 'assistencias', 'atualizadoPor', 'atualizadoEm'])
        && data.keys().hasAll(['atletaId', 'escopo', 'gols', 'assistencias', 'atualizadoPor', 'atualizadoEm'])
        && data.escopo is string && data.escopo.matches('^[0-9]{4}$')
        && data.atletaId is string && data.atletaId.size() >= 1 && data.atletaId.size() <= 40
        && ajusteId == data.escopo + '_' + data.atletaId
        && exists(/databases/$(database)/documents/times/$(timeId)/atletas/$(data.atletaId))
        && data.gols is int && data.gols >= -999 && data.gols <= 999
        && data.assistencias is int && data.assistencias >= -999 && data.assistencias <= 999
        && data.atualizadoPor == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    function diretoriaNoEvento(timeId, eventoId) {
      return podeGerir(timeId)
        && existsAfter(/databases/$(database)/documents/times/$(timeId)/eventos/$(eventoId));
    }

    function isValidConvite(data, codigo) {
      return data.keys().hasAll(['timeNome', 'ativo', 'expiraEm', 'criadoPor', 'criadoEm'])
        && data.keys().hasOnly(['timeNome', 'ativo', 'expiraEm', 'criadoPor', 'criadoEm'])
        && codigo.matches('^[A-Za-z0-9]{10,32}$')
        && data.timeNome is string && data.timeNome.size() <= 60
        && data.ativo is bool
        && data.expiraEm is timestamp
        && data.criadoPor is string && data.criadoPor.size() <= 128
        && data.criadoEm is timestamp;
    }

    function conviteVigente(timeId, codigo) {
      let convite = get(/databases/$(database)/documents/times/$(timeId)/convites/$(codigo));
      return convite != null && convite.data.ativo == true && convite.data.expiraEm > request.time;
    }

    // timeNome é cópia do nome do time. Na criação (ou se mudar) tem de bater com times.nome;
    // se o time for renomeado, acessos antigos continuam editáveis sem reescrever o nome.
    function timeNomeCoerente(timeId) {
      return request.resource.data.timeNome == nomeDoTime(timeId)
        || (resource != null && request.resource.data.timeNome == resource.data.timeNome);
    }

    function isValidCobranca(data, cobrancaId) {
      return data.keys().hasAll(['atletaId', 'atletaNome', 'tipo', 'referencia', 'valorCentavos', 'vencimento', 'status'])
        && data.keys().hasOnly(['atletaId', 'atletaNome', 'tipo', 'referencia', 'valorCentavos', 'vencimento', 'status',
          'planoNome', 'pagoEm', 'baixadoPor', 'observacao'])
        && textoOpcional(data, 'planoNome', 1, 40)
        && data.atletaId is string && data.atletaId.size() >= 1 && data.atletaId.size() <= 40
        && data.atletaNome is string && data.atletaNome.size() >= 1 && data.atletaNome.size() <= 100
        && data.tipo in ['mensal', 'semestral', 'avulso']
        && data.referencia is string
        && ((data.tipo == 'mensal' && data.referencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'))
          || (data.tipo == 'semestral' && data.referencia.matches('^[0-9]{4}-S[12]$'))
          || (data.tipo == 'avulso' && data.referencia.matches('^[A-Za-z0-9]{1,40}$')))
        && cobrancaId == data.atletaId + '_' + data.referencia
        && ehCentavos(data.valorCentavos) && data.valorCentavos > 0
        && data.vencimento is timestamp
        && data.status in ['pendente', 'pago', 'cancelado']
        && (!('pagoEm' in data) || data.pagoEm is timestamp)
        && (!('baixadoPor' in data) || (data.baixadoPor is string && data.baixadoPor.size() <= 128))
        && textoOpcional(data, 'observacao', 0, 200);
    }

    function cobrancaPath(timeId, cobrancaId) {
      return /databases/$(database)/documents/times/$(timeId)/cobrancas/$(cobrancaId);
    }

    function lancamentoDaBaixaPath(timeId, cobrancaId) {
      return /databases/$(database)/documents/times/$(timeId)/lancamentos/$('cob_' + cobrancaId);
    }

    // Transições de status da cobrança. Baixa e estorno exigem o lançamento cob_{id} no mesmo lote.
    function transicaoCobrancaValida(timeId, cobrancaId) {
      let antes = resource.data;
      let depois = request.resource.data;
      let mudou = depois.diff(antes).affectedKeys();
      let semBaixa = !('pagoEm' in depois) && !('baixadoPor' in depois);
      return (
          // baixa: pendente → pago, com a receita criada no mesmo lote
          antes.status == 'pendente' && depois.status == 'pago'
          && mudou.hasOnly(['status', 'pagoEm', 'baixadoPor', 'observacao'])
          && depois.pagoEm is timestamp
          && depois.baixadoPor == request.auth.uid
          && existsAfter(lancamentoDaBaixaPath(timeId, cobrancaId))
          && getAfter(lancamentoDaBaixaPath(timeId, cobrancaId)).data.valorCentavos == antes.valorCentavos
        ) || (
          // estorno: pago → pendente, removendo a receita no mesmo lote
          antes.status == 'pago' && depois.status == 'pendente'
          && mudou.hasOnly(['status', 'pagoEm', 'baixadoPor', 'observacao'])
          && semBaixa && !('observacao' in depois)
          && !existsAfter(lancamentoDaBaixaPath(timeId, cobrancaId))
        ) || (
          // cancelar / reabrir: só o status, entre pendente e cancelado
          ((antes.status == 'pendente' && depois.status == 'cancelado')
            || (antes.status == 'cancelado' && depois.status == 'pendente'))
          && mudou.hasOnly(['status'])
          && semBaixa
        );
    }

    function isValidLancamento(data) {
      return data.keys().hasAll(['tipo', 'categoria', 'descricao', 'valorCentavos', 'data', 'criadoPor', 'criadoEm'])
        && data.keys().hasOnly(['tipo', 'categoria', 'descricao', 'valorCentavos', 'data', 'criadoPor', 'criadoEm',
          'cobrancaId', 'recorrenteId'])
        && data.tipo in ['receita', 'despesa']
        && data.categoria is string && data.categoria.size() >= 1 && data.categoria.size() <= 40
        && data.descricao is string && data.descricao.size() >= 1 && data.descricao.size() <= 120
        && ehCentavos(data.valorCentavos) && data.valorCentavos > 0
        && data.data is timestamp
        && data.criadoPor is string && data.criadoPor.size() <= 128
        && data.criadoEm is timestamp
        && (!('cobrancaId' in data) || (data.cobrancaId is string && data.cobrancaId.size() <= 100))
        && (!('recorrenteId' in data) || (data.recorrenteId is string && data.recorrenteId.matches('^[a-z0-9]{6,20}$')));
    }

    // Origem do lançamento, amarrada ao ID: receita de baixa, despesa recorrente do mês ou manual.
    function origemLancamentoValida(timeId, lancamentoId, data) {
      return (
          lancamentoId.matches('^cob_.+')
          && 'cobrancaId' in data && !('recorrenteId' in data)
          && lancamentoId == 'cob_' + data.cobrancaId
          && data.tipo == 'receita'
          && getAfter(cobrancaPath(timeId, data.cobrancaId)).data.status == 'pago'
          && getAfter(cobrancaPath(timeId, data.cobrancaId)).data.valorCentavos == data.valorCentavos
        ) || (
          lancamentoId.matches('^rec_.+')
          && 'recorrenteId' in data && !('cobrancaId' in data)
          && lancamentoId.matches('^rec_' + data.recorrenteId + '_[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.tipo == 'despesa'
        ) || (
          !lancamentoId.matches('^(cob|rec)_.*')
          && !('cobrancaId' in data) && !('recorrenteId' in data)
        );
    }

    function isValidSolicitacao(data) {
      return data.keys().hasAll(['nome', 'email', 'status', 'convite', 'criadoEm'])
        && data.keys().hasOnly(['nome', 'email', 'status', 'convite', 'criadoEm'])
        && data.nome is string && data.nome.size() <= 100
        && data.email is string && data.email.size() <= 254
        && data.status in ['pendente', 'aprovada', 'recusada']
        && data.convite is string && data.convite.matches('^[A-Za-z0-9]{10,32}$')
        && data.criadoEm is timestamp;
    }

    // ---------------------------------------------------------------
    // usuarios/{uid}
    // Leitura: o próprio ou adminGeral. Escrita: só o próprio, sem tocar em adminGeral.
    // ---------------------------------------------------------------
    match /usuarios/{uid} {
      allow read: if isOwner(uid) || isAdminGeral();

      allow create: if isOwner(uid)
        && isValidUsuario(request.resource.data)
        && !('adminGeral' in request.resource.data)
        && request.resource.data.criadoEm == request.time;

      allow update: if isOwner(uid)
        && isValidUsuario(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'email', 'fotoUrl']);

      allow delete: if false;
    }

    // "Meus times": collection group em acessos filtrando uid == request.auth.uid.
    match /{path=**}/acessos/{acessoUid} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // times/{timeId}
    // Leitura: quem tem acesso ao time ou adminGeral. Escrita: adminGeral (financeiro: Fase 2).
    // ---------------------------------------------------------------
    match /times/{timeId} {
      allow read: if temAcesso(timeId) || isAdminGeral();

      allow create: if isAdminGeral()
        && isValidTime(request.resource.data, timeId)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.financeiro == financeiroPadrao();

      // adminGeral: identidade do time. Diretoria (ou adminGeral): só os esportes.
      // Tesouraria (ou adminGeral): só a configuração financeira.
      allow update: if isValidTime(request.resource.data, timeId)
        && (
          (isAdminGeral()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'cor', 'escudo', 'tema', 'esportes']))
          || (podeGerir(timeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['esportes']))
          || (podeFinanceiro(timeId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['financeiro'])
            && isValidFinanceiro(request.resource.data.financeiro))
        );

      allow delete: if false;

      // Permissões do usuário no time. Diretoria concede e remove qualquer papel (DIRETRIZES, seção 10).
      match /acessos/{uid} {
        allow read: if isOwner(uid) || ehDiretoria(timeId) || ehTesouraria(timeId) || isAdminGeral();
        allow create, update: if podeGerir(timeId)
          && isValidAcesso(request.resource.data, timeId, uid)
          && timeNomeCoerente(timeId);
        allow delete: if podeGerir(timeId);
      }

      match /atletas/{atletaId} {
        allow read: if temAcesso(timeId) || isAdminGeral();

        allow create: if podeGerir(timeId)
          && isValidAtleta(request.resource.data)
          && request.resource.data.criadoEm == request.time
          && vinculoComConta(request.resource.data)
          && modalidadeHabilitada(timeId, request.resource.data.modalidade);

        // Modalidade e vínculo só são conferidos quando mudam: cadastros antigos continuam editáveis
        // (ex.: sócio removido do time fica sem conta e inativo).
        allow update: if isValidAtleta(request.resource.data)
          && inalterados(['criadoEm'])
          && (inalterados(['vinculo']) || vinculoComConta(request.resource.data))
          && (podeGerir(timeId) || ehProprioAtleta(timeId, atletaId))
          && (inalterados(['modalidade']) || modalidadeHabilitada(timeId, request.resource.data.modalidade));

        // Atleta sai do elenco via status 'inativo' (histórico financeiro depende dele).
        allow delete: if false;
      }

      // Convite: qualquer logado lê por código (get); só a gestão lista.
      match /convites/{codigo} {
        allow get: if isAuthenticated();
        allow list: if podeGerir(timeId);

        allow create: if podeGerir(timeId)
          && isValidConvite(request.resource.data, codigo)
          && request.resource.data.ativo == true
          && request.resource.data.timeNome == nomeDoTime(timeId)
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && request.resource.data.expiraEm > request.time
          && request.resource.data.expiraEm < request.time + duration.value(90, 'd');

        // Só desativar.
        allow update: if podeGerir(timeId)
          && isValidConvite(request.resource.data, codigo)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo'])
          && request.resource.data.ativo == false;

        allow delete: if false;
      }

      // Cobranças: gestão lê todas; jogador só as do próprio atleta (a consulta filtra por atletaId).
      // Tesouraria cria (só pendente) e muda status pelas transições; nunca exclui.
      match /cobrancas/{cobrancaId} {
        allow read: if podeVerFinanceiro(timeId)
          || (temAcesso(timeId) && resource.data.atletaId == get(acessoPath(timeId)).data.atletaId);

        allow create: if podeFinanceiro(timeId)
          && isValidCobranca(request.resource.data, cobrancaId)
          && request.resource.data.status == 'pendente'
          && !('pagoEm' in request.resource.data)
          && !('baixadoPor' in request.resource.data);

        allow update: if podeFinanceiro(timeId)
          && isValidCobranca(request.resource.data, cobrancaId)
          && inalterados(['atletaId', 'atletaNome', 'tipo', 'referencia', 'valorCentavos', 'vencimento', 'planoNome'])
          && transicaoCobrancaValida(timeId, cobrancaId);

        allow delete: if false;
      }

      // Caixa: só gestão lê (jogador nunca). Tesouraria escreve. Receita de baixa (cob_) só nasce/some
      // junto com a cobrança; não é editável.
      match /lancamentos/{lancamentoId} {
        allow read: if podeVerFinanceiro(timeId);

        allow create: if podeFinanceiro(timeId)
          && isValidLancamento(request.resource.data)
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && origemLancamentoValida(timeId, lancamentoId, request.resource.data);

        allow update: if podeFinanceiro(timeId)
          && !lancamentoId.matches('^cob_.*')
          && isValidLancamento(request.resource.data)
          && inalterados(['tipo', 'criadoPor', 'criadoEm', 'cobrancaId', 'recorrenteId']);

        allow delete: if podeFinanceiro(timeId)
          && (!lancamentoId.matches('^cob_.*')
            || getAfter(cobrancaPath(timeId, resource.data.cobrancaId)).data.status == 'pendente');
      }

      // Agenda: todos do time leem; só a diretoria cria e edita. Sem exclusão (cancelar).
      match /eventos/{eventoId} {
        allow read: if temAcesso(timeId) || isAdminGeral();

        allow create: if podeGerir(timeId)
          && isValidEvento(request.resource.data)
          && request.resource.data.status == 'agendado'
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.criadoEm == request.time;

        allow update: if podeGerir(timeId)
          && isValidEvento(request.resource.data)
          && inalterados(['criadoPor', 'criadoEm'])
          && transicaoEventoValida(resource.data.status, request.resource.data.status);

        allow delete: if false;

        // Presença: cada um responde pelo próprio cadastro (só `resposta`); a diretoria por qualquer um,
        // incluindo `compareceu` no encerramento.
        match /presencas/{atletaId} {
          allow read: if temAcesso(timeId) || isAdminGeral();

          allow create: if isValidPresenca(request.resource.data)
            && ((respondeProprio(timeId, eventoId, atletaId)
                && 'resposta' in request.resource.data
                && !('compareceu' in request.resource.data))
              || diretoriaNoEvento(timeId, eventoId));

          allow update: if isValidPresenca(request.resource.data)
            && ((respondeProprio(timeId, eventoId, atletaId)
                && 'resposta' in request.resource.data
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resposta', 'atualizadoEm']))
              || diretoriaNoEvento(timeId, eventoId));

          allow delete: if false;
        }

        // Gols do time: só a diretoria, com o evento realizado (no mesmo lote do encerramento ou depois).
        match /gols/{golId} {
          allow read: if temAcesso(timeId) || isAdminGeral();

          allow create, update: if podeGerir(timeId)
            && isValidGol(request.resource.data, golId)
            && getAfter(/databases/$(database)/documents/times/$(timeId)/eventos/$(eventoId)).data.status == 'realizado';

          allow delete: if podeGerir(timeId);
        }
      }

      // Ajuste manual da artilharia (DIRETRIZES 2.10): todos do time leem; só a diretoria grava; sem exclusão.
      match /ajustesEstatistica/{ajusteId} {
        allow read: if temAcesso(timeId) || isAdminGeral();

        allow create, update: if podeGerir(timeId)
          && isValidAjusteEstatistica(request.resource.data, timeId, ajusteId);

        allow delete: if false;
      }

      // Apoiadores (faixa do mural): todos do time leem; só a diretoria mantém.
      match /patrocinadores/{patrocinadorId} {
        allow read: if temAcesso(timeId) || isAdminGeral();

        allow create: if podeGerir(timeId)
          && isValidPatrocinador(request.resource.data)
          && request.resource.data.criadoEm == request.time;

        allow update: if podeGerir(timeId)
          && isValidPatrocinador(request.resource.data)
          && inalterados(['criadoEm']);

        allow delete: if podeGerir(timeId);
      }

      // Mural: todos do time leem e publicam; autor edita a legenda; diretoria fixa; exclui o autor ou a diretoria.
      match /recados/{recadoId} {
        allow read: if temAcesso(timeId) || isAdminGeral();

        allow create: if temAcesso(timeId)
          && isValidRecado(request.resource.data, timeId, recadoId)
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.criadoEm == request.time
          && !('qtdCurtidas' in request.resource.data)
          && (request.resource.data.fixado == false || podeGerir(timeId));

        allow update: if isValidRecado(request.resource.data, timeId, recadoId)
          && inalterados(['titulo', 'fotos', 'autorUid', 'autorNome', 'autorFotoUrl', 'criadoEm'])
          && ((temAcesso(timeId) && resource.data.autorUid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto']))
            || (podeGerir(timeId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fixado']))
            || (temAcesso(timeId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qtdCurtidas'])
                && contadorDeCurtidaValido(timeId, recadoId)));

        allow delete: if podeGerir(timeId)
          || (temAcesso(timeId) && resource.data.autorUid == request.auth.uid);

        // Curtida: só a própria, junto com o contador do post (+1 ao criar, −1 ao apagar).
        match /curtidas/{uid} {
          allow read: if temAcesso(timeId) || isAdminGeral();

          allow create: if temAcesso(timeId)
            && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['criadoEm'])
            && request.resource.data.criadoEm == request.time
            && getAfter(recadoPath(timeId, recadoId)).data.get('qtdCurtidas', 0)
              == get(recadoPath(timeId, recadoId)).data.get('qtdCurtidas', 0) + 1;

          allow update: if false;

          allow delete: if (temAcesso(timeId)
              && uid == request.auth.uid
              && getAfter(recadoPath(timeId, recadoId)).data.get('qtdCurtidas', 0)
                == get(recadoPath(timeId, recadoId)).data.get('qtdCurtidas', 0) - 1)
            || podeLimparFilhoDoPost(timeId, recadoId);
        }

        // Comentário: qualquer membro, em post existente; sem edição.
        match /comentarios/{comentarioId} {
          allow read: if temAcesso(timeId) || isAdminGeral();

          allow create: if temAcesso(timeId)
            && exists(recadoPath(timeId, recadoId))
            && isValidComentario(request.resource.data)
            && request.resource.data.autorUid == request.auth.uid
            && request.resource.data.criadoEm == request.time;

          allow update: if false;

          allow delete: if (temAcesso(timeId) && resource.data.autorUid == request.auth.uid)
            || podeLimparFilhoDoPost(timeId, recadoId);
        }
      }

      // Pedido de entrada: criado pelo próprio com convite vigente; decidido pela gestão.
      match /solicitacoes/{uid} {
        allow read: if isOwner(uid) || podeGerir(timeId);

        allow create: if isOwner(uid)
          && isValidSolicitacao(request.resource.data)
          && request.resource.data.status == 'pendente'
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.criadoEm == request.time
          && conviteVigente(timeId, request.resource.data.convite);

        allow update: if podeGerir(timeId)
          && isValidSolicitacao(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'pendente'
          && request.resource.data.status in ['aprovada', 'recusada'];

        // Permite à gestão apagar um pedido recusado para a pessoa tentar de novo.
        allow delete: if podeGerir(timeId);
      }
    }

    // Todo o resto: negado por padrão (sem regra = sem acesso).
  }
}
